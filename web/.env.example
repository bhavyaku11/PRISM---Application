# ============================================================
# PRISM Frontend Environment Configuration Template (web/)
# ============================================================
# Copy this file to .env.local for local development.
# In Vercel, configure these in Project Settings -> Environment Variables.
#
# IMPORTANT: NEVER place secrets (e.g. SUPABASE_SERVICE_ROLE_KEY, GROQ_API_KEY)
# into this file or any file with NEXT_PUBLIC_* prefix.
# ============================================================

# Supabase Public Configuration (Safe for browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key-here

# FastAPI Backend URL (Server-side Next.js route handlers -> Railway)
# Local development default: http://127.0.0.1:8000
# Production: Set to your deployed Railway backend URL (e.g. https://prism-backend-production.up.railway.app)
FASTAPI_BACKEND_URL=http://127.0.0.1:8000
