.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
build/
mobile/build/
local.properties
.gradle/
*.iml
.idea/


# Node & Next.js
node_modules/
web/node_modules/
.pnp
.pnp.*
